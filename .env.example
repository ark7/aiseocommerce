# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ecommerce_saas?schema=public"

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Redis for Rate Limiting (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Payment Gateway - Midtrans
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_MERCHANT_ID=your_merchant_id

# Payment Gateway - Flip
FLIP_API_KEY=your_flip_api_key
FLIP_SECRET_KEY=your_flip_secret_key

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# File Upload
MAX_FILE_SIZE=2097152
UPLOAD_DIR=./public/uploads

# AI SEO
AI_SEO_API_KEY=your_ai_api_key
AI_SEO_API_URL=https://api.openai.com/v1/chat/completions
