# Database
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))")
JWT_SECRET=your-strong-secret-key-change-in-production
GUEST_SESSION_SECRET=your-strong-guest-secret-key-change-in-production

# Redis for Rate Limiting (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Payment Gateway - Midtrans
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_MERCHANT_ID=your_merchant_id

# Payment Gateway - Flip
FLIP_API_KEY=your_flip_api_key
FLIP_SECRET_KEY=your_flip_secret_key

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Reserve stock and discount quota only while an unpaid order is fresh.
# After this many minutes a PENDING order is cancelled and everything it held
# goes back on sale. Long enough to finish a bank transfer.
ORDER_RESERVATION_MINUTES=120

# Shared secret for /api/cron/release-expired, which runs that sweep. Set it and
# schedule the endpoint; with no value the endpoint refuses every call rather
# than sitting open. Without a schedule, abandoned checkouts keep holding stock
# and discount quota until someone pays or the order is cancelled by hand.
CRON_SECRET=generate-a-long-random-value

# File Upload
MAX_FILE_SIZE=2097152
UPLOAD_DIR=./public/uploads

# AI SEO
AI_SEO_API_KEY=your_ai_api_key
AI_SEO_API_URL=https://api.openai.com/v1/chat/completions
