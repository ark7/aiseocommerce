// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id        String   @id @default(cuid())
  name      String
  domain    String   @unique
  logo      String?
  address   String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  products         Product[]
  orders           Order[]
  ledgers          Ledger[]
  settings         StoreSettings?
  categories       Category[]
  pettyCashes      PettyCash[]
  productEvents    ProductEvent[]
  ledgerCategories LedgerCategory[]
  vouchers         Voucher[]
  voucherClaims    VoucherClaim[]

  @@map("stores")
}

model StoreSettings {
  id                    String   @id @default(cuid())
  storeId               String   @unique
  store                 Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  midtransMerchantId    String?
  midtransClientKey     String?
  midtransServerKey     String?
  flipApiKey            String?
  defaultSeoTitle       String?
  defaultSeoDescription String?
  googleTagId           String?
  analyticsConfig       Json?
  businessName          String?
  businessAddress       String?
  businessPhone         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("store_settings")
}

model User {
  id            String    @id @default(cuid())
  storeId       String
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email         String
  passwordHash  String
  firstName     String?
  lastName      String?
  phone         String?
  role          Role      @default(CUSTOMER)
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  resetToken    String?
  resetTokenExp DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders            Order[]
  payments          Payment[]
  stockLogs         StockLog[]
  approvedPettyCash PettyCash[]
  auditLogs         AuditLog[]
  voucherClaims     VoucherClaim[]

  @@unique([storeId, email])
  @@map("users")
}

enum Role {
  ADMIN
  CUSTOMER
  STAFF
}

model Product {
  id               String         @id @default(cuid())
  storeId          String
  store            Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sku              String?        @unique
  name             String
  slug             String
  description      String?        @db.Text
  shortDescription String?
  basePrice        Float
  sellingPrice     Float
  /// Harga coret. Dipakai storefront sejak dulu, tapi jendela dan kuota di
  /// bawah ini yang membuatnya berbatas waktu dan berkuota. `null` pada
  /// keduanya berarti tanpa batas, supaya baris lama tetap tayang.
  discountPrice    Float?
  saleStartsAt     DateTime?
  saleEndsAt       DateTime?
  saleQuota        Int?
  /// Unit yang sudah terjual di harga coret. Dipotong atomik saat checkout.
  saleSold         Int            @default(0)
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?
  stock            Int            @default(0)
  minStock         Int            @default(0)
  images           ProductImage[]
  categoryId       String?
  category         Category?      @relation(fields: [categoryId], references: [id])
  isPublished      Boolean        @default(true)
  isFeatured       Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  stockLogs     StockLog[]
  orderItems    OrderItem[]
  productEvents ProductEvent[]

  @@unique([storeId, slug])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("product_images")
}

model Category {
  id          String     @id @default(cuid())
  storeId     String
  store       Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryToCategory")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  products    Product[]

  @@unique([storeId, slug])
  @@map("categories")
}

model StockLog {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          StockType
  quantity      Int
  previousStock Int
  newStock      Int
  reason        String?
  referenceId   String?
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  createdAt     DateTime  @default(now())

  @@map("stock_logs")
}

enum StockType {
  IN
  OUT
  ADJUSTMENT
  RETURN
  DAMAGE
  RESERVATION
}

model Order {
  id              String      @id @default(cuid())
  storeId         String
  store           Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderNumber     String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  totalAmount     Float
  subtotal        Float
  taxAmount       Float       @default(0)
  shippingCost    Float       @default(0)
  discount        Float       @default(0)
  status          OrderStatus @default(PENDING)
  attribution     Json?
  notes           String?     @db.Text
  shippingAddress String?     @db.Text
  trackingUrl     String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  orderItems   OrderItem[]
  payments     Payment[]
  voucherClaim VoucherClaim?

  @@map("orders")
}

enum OrderStatus {
  PENDING
  PAID
  MANUAL_VERIFICATION
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Float
  totalPrice Float
  variation  String?
  /// Baris ini memakai jatah kuota harga coret. Dicatat saat checkout supaya
  /// pembatalan bisa mengembalikan tepat baris yang memakainya, bukan menebak
  /// dari perbandingan harga yang bisa berubah setelahnya.
  saleQuotaUsed Boolean @default(false)
  createdAt  DateTime @default(now())

  @@map("order_items")
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method          PaymentMethod
  amount          Float
  proofUrl        String?
  proofFile       String?
  proofData       String?       @db.Text
  transactionId   String?
  gatewayResponse String?       @db.Text
  status          PaymentStatus @default(PENDING)
  verifiedById    String?
  verifiedBy      User?         @relation(fields: [verifiedById], references: [id])
  verifiedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("payments")
}

enum PaymentMethod {
  MANUAL
  MIDTRANS
  FLIP
  BANK_TRANSFER
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  EXPIRED
}

model Ledger {
  id            String     @id @default(cuid())
  storeId       String
  store         Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type          LedgerType
  amount        Float
  description   String?    @db.Text
  referenceId   String?
  referenceType String?
  category      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("ledgers")
}

enum LedgerType {
  INCOME
  EXPENSE
  PETTY_CASH
  CAPITAL
  LOAN
  REFUND
}

/// The allowed `Ledger.category` names per store and type. The ledger keeps the
/// name as a plain string (see recordOrderIncome), so this table is a picklist
/// and a rename cascade, not a foreign key.
model LedgerCategory {
  id        String     @id @default(cuid())
  storeId   String
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type      LedgerType
  name      String
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([storeId, type, name])
  @@map("ledger_categories")
}

model PettyCash {
  id           String        @id @default(cuid())
  storeId      String
  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  amount       Float
  description  String?       @db.Text
  type         PettyCashType
  approvedById String?
  approvedBy   User?         @relation(fields: [approvedById], references: [id])
  approvedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("petty_cashes")
}

enum PettyCashType {
  IN
  OUT
}

model AuditLog {
  id         String   @id @default(cuid())
  storeId    String?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  oldValue   String?  @db.Text
  newValue   String?  @db.Text
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String?
  ipAddress String
  userAgent String?
  success   Boolean
  storeId   String?
  createdAt DateTime @default(now())

  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

/// The upper half of the product funnel. Orders record the conversion end and
/// carry attribution; nothing recorded what happened before a purchase, so
/// "this listing converts well" was previously unfalsifiable.
///
/// One row per (product, step, session). Storing a step per product rather than
/// one cart-level row keeps the funnel a single GROUP BY over
/// (storeId, productId, type) with no join and no array unnesting.
enum ProductEventType {
  VIEW
  ADD_TO_CART
  CHECKOUT_START
}

model ProductEvent {
  id          String           @id @default(cuid())
  storeId     String
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId   String
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        ProductEventType
  /// Anonymous, client-generated, stable per browser. Never a user id.
  sessionId   String
  /// Same shape as Order.attribution, so a funnel row and a sale join on campaign.
  attribution Json?
  createdAt   DateTime         @default(now())

  @@index([storeId, productId, type, createdAt])
  @@index([storeId, type, createdAt])
  @@map("product_events")
}

/// Diskon yang diklaim pelanggan, bukan yang dipasang langsung di keranjang.
/// `code` tetap di baris voucher dan baru ditampilkan setelah klaim — yang
/// diklaim adalah hak pakai, bukan rahasia.
enum VoucherType {
  /// `value` adalah rupiah.
  FIXED
  /// `value` adalah persen penuh (10 berarti 10%), bukan pecahan.
  PERCENT
}

model Voucher {
  id          String      @id @default(cuid())
  storeId     String
  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code        String
  name        String
  description String?
  type        VoucherType
  value       Float
  /// Batas nilai potongan. Hanya bermakna untuk PERCENT; null = tanpa batas.
  maxDiscount Float?
  /// Belanja minimum sebelum voucher boleh dipakai. null = tanpa minimum.
  minPurchase Float?
  /// Jendela berlaku. null di kedua ujung = tanpa batas waktu.
  startsAt    DateTime?
  endsAt      DateTime?
  /// Berapa kali voucher boleh diklaim. null = tanpa batas.
  quota       Int?
  claimed     Int         @default(0)
  /// Berapa kali sudah benar-benar dipakai di pesanan.
  used        Int         @default(0)
  /// Tombol on/off admin, terpisah dari jendela waktu.
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  claims VoucherClaim[]

  @@unique([storeId, code])
  @@map("vouchers")
}

model VoucherClaim {
  id        String    @id @default(cuid())
  voucherId String
  voucher   Voucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  claimedAt DateTime  @default(now())
  usedAt    DateTime?
  orderId   String?   @unique
  order     Order?    @relation(fields: [orderId], references: [id])
  Store     Store?    @relation(fields: [storeId], references: [id])
  storeId   String?

  /// Satu klaim per orang per voucher. Inilah yang membuat klaim ganda saat
  /// tombol diklik dua kali berakhir sebagai baris yang sama, bukan dua baris.
  @@unique([voucherId, userId])
  @@map("voucher_claims")
}
